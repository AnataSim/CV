rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. User Decks collection (Holds quest statuses per user)
    match /user_decks/{userId} {
      allow read, write: if true;
    }

    // 3. Submissions collection (Holds proof of quest completions)
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // 4. Quests Master collection
    match /quests/{questId} {
      allow read, write: if true;
    }

    // 5. Volunteerables, Settings, and Chat Messages
    match /volunteerables/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /chat_messages/{docId} {
      allow read, write: if true;
    }

    // Fallback rule for all documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
